# Database configuration
# -----------------------------------------------
# 1. Copy this file and rename it to: .env
# 2. Replace the values below with your own MySQL credentials
# 3. Never commit the .env file to Git — it stays on your computer only
# -----------------------------------------------

DB_URL=jdbc:mysql://localhost:3306/
DB_NAME=events_app
DB_USER=root
DB_PASSWORD=your_password_here

# -----------------------------------------------
# API data sources (optional)
# If at least one API_X_URL is set, the app will
# ask on startup whether to import events from it.
#
# API_X_KEY is optional — leave empty for public APIs.
# To add more sources, copy the block and increment the number.
# -----------------------------------------------

API_1_NAME=Vilnius Events
API_1_URL=https://comealone.app/feed/v1/city/vilnius.json
API_1_KEY=

# API_2_NAME=My Other API
# API_2_URL=https://example.com/events.json
# API_2_KEY=your_api_key_here
